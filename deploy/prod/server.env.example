# Manga Vault server secrets. Copy to `server.env` on the VM and `chmod 600`.
# Read by the `server` service via `env_file:`.

NODE_ENV=production
PORT=3000

# Host `db` is the Compose service on this stack's internal network.
# The password must be the literal value you put in ./.env — an env_file is not
# interpolated by Compose.
DATABASE_URL=postgres://mangavault:<same-as-POSTGRES_PASSWORD>@db:5432/mangavault

# Where archived cover art is written. Matches the `storage` volume mount.
STORAGE_DIR=/data/storage

# The single credential for the whole archive. Every request outside /health
# must carry `Authorization: Bearer <this>`; the guard is fail-closed, so if
# this is unset the server rejects everything.
#
# Generate with: openssl rand -hex 32
#
# This is what you type into the app's setup screen alongside the server
# address. It is NOT compiled into the APK — the published build contains no
# credential at all. Treat it like a password: anyone holding it holds your
# whole library.
API_TOKEN=change-me
