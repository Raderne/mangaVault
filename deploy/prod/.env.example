# Compose-level values, interpolated into docker-compose.yml only.
# Copy to `.env` next to the compose file on the VM and `chmod 600` it.

# Namespaces containers, volumes and the default network, so this stack cannot
# collide with expensy-prod on the same Docker daemon.
COMPOSE_PROJECT_NAME=mangavault-prod

# Generate with: openssl rand -hex 24
# Must match the password inside DATABASE_URL in server.env — Compose variables
# do not interpolate into env_file entries.
POSTGRES_PASSWORD=change-me
